<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4FBF8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вектор"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1E3530" />

    <ImageButton
        android:id="@+id/widget_mic_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/widget_mic"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="Записать задачу или заметку"
        android:scaleType="centerInside" />

</LinearLayout>
